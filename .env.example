# Get these free at https://www.last.fm/api/account/create
LASTFM_API_KEY=your_api_key_here
LASTFM_SHARED_SECRET=your_shared_secret_here

PORT=3000
# Must match the callback URL you give Last.fm (or just use this one)
BASE_URL=http://localhost:3000

# Local testing only: lets you "log in" with any Last.fm username without
# verifying ownership. NEVER enable in production.
DEV_LOGIN=true

# Artists with fewer Last.fm listeners than this count as "underground"
UNDERGROUND_MAX_LISTENERS=150000
# Users reported by this many different people are hidden from the feed
REPORT_HIDE_THRESHOLD=3
MIN_AGE=18
